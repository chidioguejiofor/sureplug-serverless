# Region SurePlug's other AWS infra lives in (see sureplug-backend's Cognito setup).
AWS_REGION=eu-west-2

# Same bucket sureplug-backend's media domain uploads to (MEDIA_S3_BUCKET there).
MEDIA_S3_BUCKET=<s3-bucket-name>

# Blur-check stage: Laplacian variance below this is treated as "too blurry,
# ask the merchant to re-upload". Needs a calibration pass against real sample
# photos - 100 is a placeholder, not a measured value. Only ever reached for
# images ClassifyImage said need background removal.
BLUR_SCORE_THRESHOLD=100

# ClassifyImage stage (Replicate) - a vision-model call answering "clean up
# this background, or keep this image as composed" (marketing graphics,
# infographics, lifestyle/context shots). Pick a vision-language / VQA-style
# model on replicate.com (e.g. a small model built for image classification
# tasks), "API" tab, copy the version hash. Its input schema (field names for
# the image/prompt) varies by model - classify-image/handler.ts assumes
# `image` + `prompt`, adjust if the chosen model differs.
IMAGE_CLASSIFIER_MODEL_VERSION=<model-owner>/<model-name>:<version-hash>

# The classify-image-callback Lambda's own HTTP API URL, once deployed. Same
# "plain manual value, not a self-referencing CloudFormation output" reasoning
# as REMOVE_BACKGROUND_CALLBACK_BASE_URL below.
CLASSIFY_IMAGE_CALLBACK_BASE_URL=<https://your-api-id.execute-api.eu-west-2.amazonaws.com>

# Background-removal stage (Replicate). Get the token from
# https://replicate.com/account/api-tokens. In a real deployment this should
# move to an SSM SecureString/Secrets Manager param rather than a plain
# Lambda environment variable (Lambda env vars are encrypted at rest but
# visible to anyone with lambda:GetFunctionConfiguration on the function) -
# flagged, not yet done.
REPLICATE_API_TOKEN=<replicate-api-token>

# The specific pinned model version to run - open the model's page on
# replicate.com (e.g. a lean segmentation model per the pipeline design doc),
# "API" tab, copy the version hash after the model name.
BACKGROUND_REMOVAL_MODEL_VERSION=<model-owner>/<model-name>:<version-hash>

# The remove-background-callback Lambda's own HTTP API URL, once it exists
# and is deployed (not yet - the callback Lambda + API Gateway wiring land in
# the next phase). Deliberately a plain manual value rather than a
# self-referencing CloudFormation output, to avoid a circular deploy
# dependency - update this once you have a real URL, then redeploy.
REMOVE_BACKGROUND_CALLBACK_BASE_URL=<https://your-api-id.execute-api.eu-west-2.amazonaws.com>

# Signing secret for verifying Replicate's webhook calls - shared by both
# callback Lambdas (HMAC-SHA256 over "{webhook-id}.{webhook-timestamp}.{raw
# body}", per https://replicate.com/docs/topics/webhooks/verify-webhook).
# Fetch it once via `GET https://api.replicate.com/v1/webhooks/default/secret`
# (needs REPLICATE_API_TOKEN) and take the part after the `whsec_` prefix.
REPLICATE_WEBHOOK_SECRET=<base64-secret-without-the-whsec_-prefix>

# How long the presigned URL handed to Replicate (so it can fetch the raw
# upload) stays valid.
SOURCE_IMAGE_URL_TTL_SECONDS=900

# CropSubject stage. Subject-detection sanity check on the background-removal
# output's alpha channel. Below MIN -> "no_product_detected"; above MAX ->
# "background_removal_failed". Both need a calibration pass against real
# sample photos, same as BLUR_SCORE_THRESHOLD.
MIN_SUBJECT_COVERAGE_RATIO=0.02
MAX_SUBJECT_COVERAGE_RATIO=0.98

# How much padding to add around the subject's bounding box before cropping,
# as a fraction of the box's own width/height.
CROP_PADDING_RATIO=0.05

# --- Not yet used by any deployed stage - present so the shape of what's
# coming is visible; wire these up as each stage lands (RenderVariants, via
# compose-on-neutral-background.ts, which is already built). ---

# Slightly off-white rather than pure #FFFFFF, specifically so a near-white
# product doesn't lose all edge definition against the backdrop - see
# README's "Why the master stays transparent" section.
NEUTRAL_BACKGROUND_COLOR=#FAFAFA

# Synthesized contact-shadow geometry (an ellipse under the subject, per
# contact-shadow.ts) - width/height as a fraction of the subject's own
# bounding box, blur as a fraction of the shadow's own height, opacity 0-1.
# All four need a calibration pass against real sample photos.
CONTACT_SHADOW_WIDTH_RATIO=0.7
CONTACT_SHADOW_HEIGHT_RATIO=0.1
CONTACT_SHADOW_BLUR_RATIO=0.35
CONTACT_SHADOW_OPACITY=0.28

# report-result stage calls back into sureplug-backend's
# POST /media/internal/pipeline-result, sending this value in the
# X-Media-Pipeline-Secret header (must match sureplug-backend's
# MEDIA_PIPELINE_WEBHOOK_SECRET - compared there with a timing-safe check).
APP_INTERNAL_WEBHOOK_URL=<https://api.sureplug.example/api/media/internal/pipeline-result>
MEDIA_PIPELINE_WEBHOOK_SECRET=<shared-secret-sent-as-x-media-pipeline-secret-header>
