# Region SurePlug's other AWS infra lives in (see sureplug-backend's Cognito setup).
AWS_REGION=eu-west-2

# Same bucket sureplug-backend's media domain uploads to (MEDIA_S3_BUCKET there).
MEDIA_S3_BUCKET=<s3-bucket-name>

# Blur-check stage: Laplacian variance below this is treated as "too blurry,
# ask the merchant to re-upload". Needs a calibration pass against real sample
# photos - 100 is a placeholder, not a measured value.
BLUR_SCORE_THRESHOLD=100

# --- Not yet used by any deployed stage - present so the shape of what's
# coming is visible; wire these up as each stage lands. ---

# Background-removal + upscale stages (Replicate-hosted models).
REPLICATE_API_TOKEN=<replicate-api-token>

# report-result stage calls back into sureplug-backend's
# POST /media/internal/pipeline-result, sending this value in the
# X-Media-Pipeline-Secret header (must match sureplug-backend's
# MEDIA_PIPELINE_WEBHOOK_SECRET - compared there with a timing-safe check).
APP_INTERNAL_WEBHOOK_URL=<https://api.sureplug.example/api/media/internal/pipeline-result>
MEDIA_PIPELINE_WEBHOOK_SECRET=<shared-secret-sent-as-x-media-pipeline-secret-header>
