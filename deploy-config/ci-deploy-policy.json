{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationDeploy",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:*:*:stack/sureplug-media-pipeline-*/*"
    },
    {
      "Sid": "DeploymentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:PutBucketPolicy",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::sureplug-media-pipeline-*",
        "arn:aws:s3:::sureplug-media-pipeline-*/*"
      ]
    },
    {
      "Sid": "ServerlessFrameworkDeploymentBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::sureplug-serverless-deployment-*",
        "arn:aws:s3:::sureplug-serverless-deployment-*/*"
      ]
    },
    {
      "Sid": "LambdaManage",
      "Effect": "Allow",
      "Action": ["lambda:*"],
      "Resource": "arn:aws:lambda:*:*:function:sureplug-media-pipeline-*"
    },
    {
      "Sid": "IamForLambdaAndSchedulerRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::*:role/sureplug-media-pipeline-*"
    },
    {
      "Sid": "PassRoleToLambdaAndScheduler",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/sureplug-media-pipeline-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ["lambda.amazonaws.com", "scheduler.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DescribeLogGroups",
        "logs:PutRetentionPolicy",
        "logs:TagLogGroup",
        "logs:TagResource"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/sureplug-media-pipeline-*"
    },
    {
      "Sid": "StepFunctions",
      "Effect": "Allow",
      "Action": [
        "states:CreateStateMachine",
        "states:DeleteStateMachine",
        "states:DescribeStateMachine",
        "states:UpdateStateMachine",
        "states:ListStateMachines",
        "states:TagResource",
        "states:UntagResource"
      ],
      "Resource": "arn:aws:states:*:*:stateMachine:sureplug-media-pipeline-*"
    },
    {
      "Sid": "EventBridgeApiDestination",
      "Effect": "Allow",
      "Action": [
        "events:CreateConnection",
        "events:DeleteConnection",
        "events:DescribeConnection",
        "events:UpdateConnection",
        "events:CreateApiDestination",
        "events:DeleteApiDestination",
        "events:DescribeApiDestination",
        "events:UpdateApiDestination"
      ],
      "Resource": [
        "arn:aws:events:*:*:connection/sureplug-notification-dispatch-*/*",
        "arn:aws:events:*:*:api-destination/sureplug-notification-dispatch-*/*"
      ]
    },
    {
      "Sid": "EventBridgeScheduler",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:TagResource"
      ],
      "Resource": "arn:aws:scheduler:*:*:schedule/default/notification-outbox-dispatch-*"
    },
    {
      "Sid": "ApiGatewayHttpApi",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "*"
    },
    {
      "Sid": "ReadDeploySecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:*:*:secret:sureplug-serverless/*"
    }
  ]
}
