{
  "name": "sureplug-serverless",
  "version": "1.0.0",
  "private": true,
  "description": "SurePlug product-image processing pipeline (Step Functions + Lambda), deployed with Serverless Framework",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tdd": "vitest",
    "templates": "tsx src/email-templates/cli/command.ts",
    "package": "serverless package",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/client-ses": "^3.1140.0",
    "@aws-sdk/client-sfn": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "dotenv": "^18.0.5",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^24.19.1",
    "@types/prompts": "^2.4.9",
    "prompts": "^2.4.2",
    "serverless": "^4.41.1",
    "serverless-esbuild": "^1.55.0",
    "serverless-step-functions": "^3.21.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
